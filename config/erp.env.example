# IPE ERP integration — Odoo 19 local
ERP_PROVIDER=odoo

# Odoo 19 (host machine — use host.docker.internal from Docker services)
ODOO_URL=http://host.docker.internal:8069
ODOO_DB=starttrans1
ODOO_USERNAME=admin
ODOO_PASSWORD=admin
ODOO_API_KEY=ipe-local-dev-key-change-in-production
ODOO_TIMEOUT=30
ODOO_ENABLED=true
ODOO_SYNC_FULL_CRON=0 2 * * *
ODOO_SYNC_INCREMENTAL_INTERVAL=1800
ODOO_BATCH_SIZE=500

# Legacy XML-RPC (Release 1 batch sync — same creds as above)
# Stored in cdm_tenant.config via configure-odoo-local.sql

# SAP / D365 (POST-R2)
SAP_ASHOST=
SAP_SYSNR=00
SAP_CLIENT=100
SAP_USER=
SAP_PASSWORD=
D365_TENANT_ID=
D365_CLIENT_ID=
D365_CLIENT_SECRET=
D365_RESOURCE=https://your-org.operations.dynamics.com
