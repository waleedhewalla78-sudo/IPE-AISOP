# Star Trans IPE Deployment Configuration
# Copy to .env and fill in actual values before running docker compose up
# Generated: 2026-07-11 | IPE v9.2.0-planning | Release 1 profile

# =============================================================================
# DATABASE
# =============================================================================
POSTGRES_USER=ipe
POSTGRES_PASSWORD=CHANGEME-USE-STRONG-PASSWORD
POSTGRES_DB=ipe

# Full connection URL (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://ipe:CHANGEME-USE-STRONG-PASSWORD@db:5432/ipe

# =============================================================================
# REDIS
# =============================================================================
REDIS_URL=redis://redis:6379/0

# =============================================================================
# AUTHENTICATION
# =============================================================================
# JWT secret for signing tokens — MUST be a random 256-bit value
IPE_JWT_SECRET_KEY=GENERATE-A-SECURE-RANDOM-KEY-HERE
AUTH_MODE=local

# =============================================================================
# ODOO CONNECTION (Star Trans ERP)
# =============================================================================
# Replace with actual Star Trans Odoo server details
ODOO_URL=http://STAR-TRANS-ODOO-HOST:8069
ODOO_DB=STAR-TRANS-DATABASE-NAME
ODOO_USER=ODOO-API-USERNAME
ODOO_PASSWORD=ODOO-API-USER-PASSWORD

# Odoo version: 17 or 19 (confirm with Star Trans IT)
# ODOO_VERSION=19

# =============================================================================
# FRONTEND
# =============================================================================
VITE_RELEASE_PROFILE=release1
VITE_DEFAULT_LOCALE=ar
VITE_API_BASE_URL=

# =============================================================================
# SYNC SETTINGS
# =============================================================================
# Sync interval in seconds (default: 900 = 15 minutes)
SYNC_INTERVAL_SECONDS=900
ODOO_SYNC_INTERVAL_SEC=900

# Auto-propose resolutions when confidence >= threshold (0-100)
AUTO_PROPOSE_THRESHOLD=75

# =============================================================================
# KAFKA (DISABLED for Release 1)
# =============================================================================
IPE_KAFKA_ENABLED=false
IPE_KAFKA_BOOTSTRAP_SERVERS=

# =============================================================================
# RELEASE PROFILE
# =============================================================================
IPE_RELEASE_PROFILE=release1

# =============================================================================
# OPTIONAL: KMS (Key Management)
# =============================================================================
IPE_KMS_KEY_DIR=/data/kms

# =============================================================================
# OPTIONAL: OBSERVABILITY (disable for initial deployment)
# =============================================================================
IPE_OTEL_TRACING_ENABLED=false
IPE_OTEL_LOGGING_ENABLED=false
