# Star Trans production env — PLACEHOLDERS ONLY (BATCH2-1)
# Copy values from Hetzner secrets manager. Never commit real secrets.

IPE_TENANT_SLUG=star-trans
IPE_TENANT_CANONICAL_UUID=6a7281ee-62cb-5a72-8162-d3c573e54877
IPE_TIMEZONE=Africa/Cairo
IPE_LOCALE=en-EG
IPE_LOCALE_FALLBACK=ar-EG
IPE_CURRENCY=EGP

# Secrets manager paths (not values)
IPE_DATABASE_URL=<SECRET_PLACEHOLDER:hetzner-secrets://ipe/tenants/star-trans/database-url>
IPE_REDIS_URL=<SECRET_PLACEHOLDER:hetzner-secrets://ipe/tenants/star-trans/redis-url>
IPE_JWT_SECRET_KEY=<SECRET_PLACEHOLDER:hetzner-secrets://ipe/tenants/star-trans/jwt>
IPE_COPILOT_HMAC_SECRET=<SECRET_PLACEHOLDER:hetzner-secrets://ipe/tenants/star-trans/copilot-hmac>
IPE_ENCRYPTION_KEY=<SECRET_PLACEHOLDER:hetzner-secrets://ipe/tenants/star-trans/fernet>

# Odoo — Wave 1 read-only later; do NOT put production credentials here
IPE_ODOO_URL=<SECRET_PLACEHOLDER:hetzner-secrets://ipe/tenants/star-trans/odoo-url>
IPE_ODOO_DB=<SECRET_PLACEHOLDER>
IPE_ODOO_USER=<SECRET_PLACEHOLDER>
IPE_ODOO_PASSWORD=<SECRET_PLACEHOLDER>

LANGFUSE_PUBLIC_KEY=<SECRET_PLACEHOLDER:hetzner-secrets://ipe/tenants/star-trans/langfuse-public>
LANGFUSE_SECRET_KEY=<SECRET_PLACEHOLDER:hetzner-secrets://ipe/tenants/star-trans/langfuse-secret>
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PROJECT=ipe-star-trans
