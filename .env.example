# ─── Database ───────────────────────────────────────────────────────────────
IPE_DATABASE_URL=postgresql+asyncpg://ipe:ipe_dev_pass@localhost:5432/ipe_dev
IPE_DATABASE_URL_SYNC=postgresql://ipe:ipe_dev_pass@localhost:5432/ipe_dev

# ─── Kafka ──────────────────────────────────────────────────────────────────
IPE_KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ─── Redis ──────────────────────────────────────────────────────────────────
IPE_REDIS_URL=redis://localhost:6379/0

# ─── JWT ────────────────────────────────────────────────────────────────────
IPE_JWT_SECRET_KEY=dev-only-change-in-production-min-32-chars-long!!
IPE_JWT_ALGORITHM=HS256
IPE_JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
IPE_JWT_REFRESH_TOKEN_EXPIRE_MINUTES=1440

# ─── External APIs ─────────────────────────────────────────────────────────
IPE_ANTHROPIC_API_KEY=sk-ant-placeholder
# OpenRouter (OpenAI-compatible) — preferred for Copilot when set
IPE_OPENROUTER_API_KEY=
IPE_OPENROUTER_MODEL=google/gemini-2.5-flash
IPE_LLM_PRIMARY_PROVIDER=auto
# Ollama (local LLM) — set for air-gapped / on-prem
IPE_OLLAMA_ENDPOINT_URL=
IPE_OLLAMA_MODEL=llama3.1:8b
IPE_SENTRY_DSN=

# ─── Service URLs (local dev) ──────────────────────────────────────────────
IPE_DPE_SVC_URL=http://localhost:8001
IPE_MAT_SVC_URL=http://localhost:8002
IPE_CAP_SVC_URL=http://localhost:8003
IPE_FEA_SVC_URL=http://localhost:8004
IPE_RES_SVC_URL=http://localhost:8005
IPE_DEL_SVC_URL=http://localhost:8006
IPE_NLP_SVC_URL=http://localhost:8007

# ─── Environment ────────────────────────────────────────────────────────────
IPE_ENVIRONMENT=development
IPE_LOG_LEVEL=DEBUG
IPE_CORS_ORIGINS=http://localhost:8082,http://localhost:3000
