# Shared env for IPE Docker Compose app services (Gate 2 E2E alignment)
IPE_JWT_SECRET_KEY=dev-only-change-in-production-min-32-chars-long!!
IPE_ENVIRONMENT=development
# App services use env_prefix IPE_ — must match docker-compose service hostnames
IPE_DATABASE_URL=postgresql+asyncpg://ipe:ipe_test_pass@db:5432/ipe_test
IPE_DATABASE_URL_SYNC=postgresql://ipe:ipe_test_pass@db:5432/ipe_test
IPE_KAFKA_BOOTSTRAP_SERVERS=kafka:9092
IPE_REDIS_URL=redis://redis:6379/0
# Disable OTEL export when otel-collector is not running (avoids E2E timeouts)
IPE_OTEL_TRACING_ENABLED=false
IPE_OTEL_LOGGING_ENABLED=false
# RS256 JWT (Phase 0.1) — mount config/keys in docker-compose
IPE_JWT_SIGNING_MODE=rs256
IPE_JWT_PUBLIC_KEY_PATH=/app/config/keys/jwt-public.pem
IPE_JWT_PRIVATE_KEY_PATH=/app/config/keys/jwt-private.pem
IPE_JWT_KEY_ID=ipe-rs256-v1
# Keycloak SSO (Phase 0.2) — set AUTH_MODE=keycloak to activate
AUTH_MODE=local
AUTH_PROVIDER=local
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_REALM=ipe
KEYCLOAK_CLIENT_ID=ipe-platform
KEYCLOAK_PUBLIC_URL=http://localhost:8180
# Vault (Phase 0.3) — set VAULT_ENABLED=true + SECRETS_PROVIDER=hashi_vault
VAULT_ENABLED=false
SECRETS_PROVIDER=env
VAULT_ADDR=http://vault:8200
VAULT_TOKEN=ipe-dev-root
VAULT_KV_MOUNT=ipe
# Audit hardening (Phase 0.5)
IPE_AUDIT_REQUEST_MIDDLEWARE=false
IPE_AUDIT_KAFKA_ENABLED=false
IPE_AUDIT_KAFKA_TOPIC=ipe.audit.v3
IPE_MINIO_ENDPOINT=http://minio:9000
IPE_MINIO_ACCESS_KEY=ipe
IPE_MINIO_SECRET_KEY=ipe-minio-pass
IPE_MINIO_AUDIT_BUCKET=ipe-audit-archive
