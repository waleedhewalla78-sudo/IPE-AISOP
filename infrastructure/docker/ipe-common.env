# Shared env for IPE Docker Compose app services (Gate 2 E2E alignment)
IPE_JWT_SECRET_KEY=dev-only-change-in-production-min-32-chars-long!!
IPE_ENVIRONMENT=development
# App services use env_prefix IPE_ — must match docker-compose service hostnames
IPE_DATABASE_URL=postgresql+asyncpg://ipe:ipe_test_pass@db:5432/ipe_test
IPE_DATABASE_URL_SYNC=postgresql://ipe:ipe_test_pass@db:5432/ipe_test
IPE_KAFKA_BOOTSTRAP_SERVERS=kafka:9092
IPE_REDIS_URL=redis://redis:6379/0
# Disable OTEL export when otel-collector is not running (avoids E2E timeouts)
IPE_OTEL_TRACING_ENABLED=false
IPE_OTEL_LOGGING_ENABLED=false
