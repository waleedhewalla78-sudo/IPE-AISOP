# Ollama local LLM — copy to infrastructure/docker/.env and customize
# Used with: docker compose -f docker-compose.yml -f docker-compose.demo.yml -f docker-compose.ollama.yml up -d

IPE_LLM_PRIMARY_PROVIDER=ollama
IPE_OLLAMA_ENDPOINT_URL=http://ollama:11434
IPE_OLLAMA_MODEL=llama3.2:3b

# Disable cloud LLMs when running air-gapped
IPE_OPENROUTER_API_KEY=
IPE_ANTHROPIC_API_KEY=

# Host Ollama (Windows/Mac, no ollama container):
# docker compose -f docker-compose.yml -f docker-compose.demo.yml -f docker-compose.ollama-host.yml up -d
# IPE_OLLAMA_ENDPOINT_URL=http://host.docker.internal:11434
# IPE_OLLAMA_MODEL=llama3.2:3b

# Optional tuning (host Ollama, not in container — set on ollama service if needed)
# OLLAMA_NUM_PARALLEL=2
# OLLAMA_MAX_LOADED_MODELS=1
