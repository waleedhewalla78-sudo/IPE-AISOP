{
  "title": "IPE API Latency",
  "uid": "ipe-api-latency",
  "version": 1,
  "tags": ["ipe", "phase2", "api"],
  "schemaVersion": 39,
  "timezone": "utc",
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "P50 Latency by Service",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le, service) (rate(ipe_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "{{ service }}"
        }
      ]
    },
    {
      "id": 2,
      "title": "P95 Latency by Service (SLO: 500ms)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 0.5 }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, service) (rate(ipe_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "{{ service }}"
        }
      ]
    },
    {
      "id": 3,
      "title": "P99 Latency by Service",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum by (le, service) (rate(ipe_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "{{ service }}"
        }
      ]
    },
    {
      "id": 4,
      "title": "In-Flight Requests",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "sum(ipe_http_requests_in_flight) by (service)",
          "legendFormat": "{{ service }}"
        }
      ]
    }
  ]
}
