{
  "title": "IPE k6 Performance Metrics",
  "uid": "ipe-k6-performance",
  "panels": [
    {
      "title": "Virtual Users",
      "type": "graph",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "k6_vus",
          "legendFormat": "VUs",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Request Rate",
      "type": "graph",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "rate(k6_http_request_duration_seconds_count[30s])",
          "legendFormat": "req/s",
          "refId": "A"
        }
      ]
    },
    {
      "title": "p95 / p99 Latency",
      "type": "graph",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(k6_http_request_duration_seconds_bucket[30s])) by (le))",
          "legendFormat": "p95",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(k6_http_request_duration_seconds_bucket[30s])) by (le))",
          "legendFormat": "p99",
          "refId": "B"
        }
      ]
    },
    {
      "title": "Error Rate",
      "type": "graph",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "rate(k6_http_request_duration_seconds_count{error=\"true\"}[30s]) / rate(k6_http_request_duration_seconds_count[30s])",
          "legendFormat": "error rate",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Per-Endpoint Duration (p95)",
      "type": "graph",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(demand_duration_bucket[30s])) by (le))",
          "legendFormat": "demand",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(mat_duration_bucket[30s])) by (le))",
          "legendFormat": "material",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(cap_duration_bucket[30s])) by (le))",
          "legendFormat": "capacity",
          "refId": "C"
        }
      ]
    }
  ],
  "schemaVersion": 39,
  "version": 1,
  "timezone": "utc"
}
