{
  "dashboard": {
    "title": "IPE Production Operations",
    "uid": "ipe-operations",
    "tags": ["ipe", "production", "operations"],
    "timezone": "browser",
    "panels": [
      {
        "title": "Service Health",
        "type": "stat",
        "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
        "targets": [
          {
            "expr": "up{job=~\"ipe-.*\"}",
            "legendFormat": "{{instance}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "thresholds": {
              "steps": [
                { "color": "red", "value": 0 },
                { "color": "green", "value": 1 }
              ]
            }
          }
        }
      },
      {
        "title": "Request Rate (req/s)",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
        "targets": [
          {
            "expr": "sum(rate(http_requests_total{job=~\"ipe-.*\"}[5m])) by (instance)",
            "legendFormat": "{{instance}}"
          }
        ]
      },
      {
        "title": "p95 Latency (ms)",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
        "targets": [
          {
            "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{job=~\"ipe-.*\"}[5m])) by (le, instance)) * 1000",
            "legendFormat": "{{instance}}"
          }
        ]
      },
      {
        "title": "Error Rate (%)",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
        "targets": [
          {
            "expr": "sum(rate(http_requests_total{job=~\"ipe-.*\",status=~\"5..\"}[5m])) by (instance) / sum(rate(http_requests_total{job=~\"ipe-.*\"}[5m])) by (instance) * 100",
            "legendFormat": "{{instance}}"
          }
        ]
      },
      {
        "title": "Kafka Consumer Lag",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
        "targets": [
          {
            "expr": "sum(kafka_consumer_group_lag) by (topic, group)",
            "legendFormat": "{{topic}}/{{group}}"
          }
        ]
      },
      {
        "title": "Active Tenants",
        "type": "stat",
        "gridPos": { "h": 4, "w": 6, "x": 0, "y": 20 },
        "targets": [
          {
            "expr": "count(count by (tenant_id) (http_requests_total{job=~\"ipe-.*\"}))",
            "legendFormat": "Tenants"
          }
        ]
      },
      {
        "title": "Open Telemetry Traces",
        "type": "table",
        "gridPos": { "h": 8, "w": 18, "x": 6, "y": 20 },
        "targets": [
          {
            "expr": "topk(10, sum by (operation) (rate(http_requests_total{job=~\"ipe-.*\"}[5m])))",
            "legendFormat": "{{operation}}",
            "instant": true
          }
        ]
      }
    ],
    "time": { "from": "now-1h", "to": "now" },
    "refresh": "30s"
  }
}
