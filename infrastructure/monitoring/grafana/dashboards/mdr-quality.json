      "targets": [
        {
          "expr": "sum(rate(ipe_feasibility_pass_total{tenant_id=~\"$tenant_id\"}[5m])) / clamp_min(sum(rate(ipe_feasibility_evaluations_total{tenant_id=~\"$tenant_id\"}[5m])), 1e-9)",
