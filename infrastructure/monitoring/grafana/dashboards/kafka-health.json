  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Consumer Lag & Throughput",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 2,
      "title": "Consumer Lag (IPE + Kafka exporter)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "expr": "max by (service, topic, consumer_group) (ipe_kafka_consumer_lag{topic=~\"$topic\"}) or max by (consumergroup, topic) (kafka_consumergroup_lag{consumergroup=~\"$consumer_group\",topic=~\"$topic\"})",
          "legendFormat": "{{ topic }} / {{ consumer_group }}",
          "refId": "A",
          "instant": false,
          "range": true
        }
      ]
    },
    {
      "id": 3,
      "title": "Messages In / Out per Second",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "targets": [
        {
          "expr": "sum(rate(kafka_topic_partition_current_offset[5m]))",
          "legendFormat": "topic offset rate",
          "refId": "A"
        },
        {
          "expr": "sum(rate(kafka_consumergroup_current_offset[5m]))",
          "legendFormat": "consumer offset rate",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        }
      }
    },
    {
      "id": 4,
      "type": "row",
      "title": "Groups & Offsets",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 9
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 5,
      "title": "Consumer Group Status",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 10
      },
      "targets": [
        {
          "expr": "kafka_consumergroup_lag{consumergroup=~\"$consumer_group\",topic=~\"$topic\"}",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 6,
      "title": "Topic Partition Current Offset",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 10
      },
      "targets": [
        {
          "expr": "kafka_topic_partition_current_offset{topic=~\"$topic\"}",
          "legendFormat": "{{ topic }}-{{ partition }}",
          "refId": "A",
          "instant": false,
          "range": true
        }
      ]
    },
    {
      "id": 7,
      "type": "row",
      "title": "Producer Health",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 18
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 8,
      "title": "Producer Success vs Failure (HTTP 5xx proxy)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 19
      },
      "targets": [
        {
          "expr": "sum(rate(ipe_http_requests_total{status_code!~\"5..\"}[5m])) / clamp_min(sum(rate(ipe_http_requests_total[5m])), 1e-9)",
          "legendFormat": "",
          "refId": "A",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        }
      }
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": [
    "ipe",
    "phase2",
    "kafka"
  ],
  "templating": {
    "list": [
      {
        "name": "topic",
