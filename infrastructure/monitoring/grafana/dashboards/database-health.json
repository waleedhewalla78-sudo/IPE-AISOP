{
  "annotations": {
    "list": []
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Connection Pool",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 2,
      "title": "DB Pool: Size / Checked Out / Overflow",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "expr": "ipe_db_pool_size{service=~\"$service\"}",
          "legendFormat": "size {{service}}",
          "refId": "A"
        },
        {
          "expr": "ipe_db_pool_checked_out{service=~\"$service\"}",
          "legendFormat": "checked out {{service}}",
          "refId": "B"
        },
        {
          "expr": "ipe_db_pool_overflow{service=~\"$service\"}",
          "legendFormat": "overflow {{service}}",
          "refId": "C"
        }
      ]
    },
    {
      "id": 3,
      "title": "Query Duration P95 (HTTP proxy)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, service) (rate(ipe_http_request_duration_seconds_bucket{service=~\"$service\"}[5m])))",
          "legendFormat": "{{ service }}",
          "refId": "A",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      }
    },
    {
      "id": 4,
      "type": "row",
      "title": "Database Activity",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 9
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 5,
      "title": "Active DB Connections (Postgres)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 10
      },
      "targets": [
        {
          "expr": "sum(pg_stat_activity_count) by (datname)",
          "legendFormat": "{{ datname }}",
          "refId": "A",
          "instant": false,
          "range": true
        }
      ]
    },
    {
      "id": 6,
      "title": "Pool Utilization %",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 10
      },
      "targets": [
        {
          "expr": "100 * ipe_db_pool_checked_out{service=~\"$service\"} / clamp_min(ipe_db_pool_size{service=~\"$service\"}, 1)",
          "legendFormat": "{{ service }}",
          "refId": "A",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        }
      }
    },
    {
      "id": 7,
      "type": "row",
      "title": "Tables & Deadlocks",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 18
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 8,
      "title": "Top 10 Table Row Counts",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 14,
        "x": 0,
        "y": 19
      },
      "targets": [
        {
          "expr": "topk(10, pg_stat_user_tables_n_live_tup)",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 9,
      "title": "Deadlocks",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 10,
        "x": 14,
        "y": 19
      },
      "targets": [
        {
          "expr": "sum(rate(pg_stat_database_deadlocks[5m])) by (datname)",
          "legendFormat": "{{ datname }}",
          "refId": "A",
          "instant": false,
          "range": true
        }
      ]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": [
    "ipe",
    "phase2",
    "database"
  ],
  "templating": {
    "list": [
      {
        "name": "service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(ipe_db_pool_size, service)",
          "refId": "StandardVariableQuery"
        },
        "refresh": 1,
        "includeAll": true,
        "multi": true,
        "current": {}
      }
    ]
  },
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timezone": "utc",
  "title": "IPE Database Health",
  "uid": "ipe-database-health",
  "version": 1
}