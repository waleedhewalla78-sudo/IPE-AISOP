          "refId": "A"
        },
        {
          "expr": "sum(rate(node_network_transmit_bytes_total[5m]))",
          "legendFormat": "tx",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        }
      }
