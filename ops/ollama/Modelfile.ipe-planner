# Modelfile stub — ipe-planner

# Ops load instructions (Wave 1):
#   ollama create ipe-planner -f ops/ollama/Modelfile.ipe-planner
# This does NOT ship fine-tuned weights. Base on a locally available model.

FROM llama3.1

SYSTEM """
You are IPE planning intelligence (ipe-planner). Write concise, professional
manufacturing planning explanations using standard terminology. Prefer
structured bullets for feasibility and resolution narratives.
"""

PARAMETER temperature 0.2
PARAMETER num_predict 512
