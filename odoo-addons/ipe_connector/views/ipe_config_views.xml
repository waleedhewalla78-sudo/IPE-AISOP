<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="ipe_config_form_view" model="ir.ui.view">
    <field name="name">ipe.config.form</field>
    <field name="model">ipe.config</field>
    <field name="arch" type="xml">
      <form string="IPE Connector Configuration">
        <sheet>
          <group>
            <group string="Connection">
              <field name="tenant_id" required="1"/>
              <field name="api_endpoint" required="1" widget="url"/>
              <field name="api_key" password="1"/>
              <field name="api_secret" password="1"/>
            </group>
            <group string="Synchronization">
              <field name="sync_interval_minutes"/>
              <field name="auto_sync_enabled"/>
              <field name="active"/>
            </group>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="ipe_config_tree_view" model="ir.ui.view">
    <field name="name">ipe.config.tree</field>
    <field name="model">ipe.config</field>
    <field name="arch" type="xml">
      <tree string="IPE Configurations" editable="bottom">
        <field name="tenant_id"/>
        <field name="api_endpoint"/>
        <field name="auto_sync_enabled"/>
        <field name="active"/>
      </tree>
    </field>
  </record>

  <record id="ipe_config_action" model="ir.actions.act_window">
    <field name="name">IPE Configuration</field>
    <field name="res_model">ipe.config</field>
    <field name="view_mode">tree,form</field>
    <field name="help">Configure the IPE connector settings for real-time planning integration.</field>
  </record>

  <menuitem id="ipe_menu" name="IPE Connector" sequence="100"/>
  <menuitem id="ipe_config_menu" name="Configuration" parent="ipe_menu" action="ipe_config_action" sequence="10"/>
</odoo>
