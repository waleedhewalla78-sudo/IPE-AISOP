# ═══════════════════════════════════════════════════════════════════════════════
# IPE Platform — Environment Variable Template
# Copy this file to .env and fill in real values before deployment.
# ═══════════════════════════════════════════════════════════════════════════════

# ─── Database (REQUIRED) ─────────────────────────────────────────────────────
IPE_DATABASE_URL=postgresql+asyncpg://ipe:ipe_test_pass@localhost:5433/ipe_test
IPE_DATABASE_URL_SYNC=postgresql://ipe:ipe_test_pass@localhost:5433/ipe_test

# Docker Compose (in-container services use IPE_* vars via infrastructure/docker/ipe-common.env)
# Inside compose network: db:5432, kafka:9092, redis:6379
# Host port 6380 when using docker-compose (maps container 6379)
IPE_REDIS_URL=redis://localhost:6380/0

# ─── Kafka (REQUIRED) ────────────────────────────────────────────────────────
IPE_KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ─── Auth (REQUIRED) ─────────────────────────────────────────────────────────
IPE_JWT_SECRET_KEY=dev-only-change-in-production-min-32-chars-long!!
IPE_JWT_ALGORITHM=HS256
IPE_JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
IPE_JWT_REFRESH_TOKEN_EXPIRE_MINUTES=1440

# Fernet key for ERP connection password encryption (W1-04)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
IPE_ENCRYPTION_KEY=

# JWKS (optional — set IPE_JWT_USE_JWKS=true for RS256)
IPE_JWT_USE_JWKS=false
IPE_JWT_JWKS_URL=

# Keycloak (optional)
IPE_KEYCLOAK_URL=
IPE_KEYCLOAK_REALM=ipe

# ─── External APIs ───────────────────────────────────────────────────────────
IPE_ANTHROPIC_API_KEY=sk-ant-placeholder
IPE_WEATHER_API_KEY=

# ─── Observability ───────────────────────────────────────────────────────────
IPE_SENTRY_DSN=
IPE_OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
IPE_OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=
IPE_OTEL_TRACING_ENABLED=true
IPE_OTEL_LOGGING_ENABLED=true

# ─── Service URLs (docker-compose host ports) ────────────────────────────────
IPE_DPE_SVC_URL=http://localhost:8020
IPE_MAT_SVC_URL=http://localhost:8002
IPE_CAP_SVC_URL=http://localhost:8003
IPE_FEA_SVC_URL=http://localhost:8004
IPE_RES_SVC_URL=http://localhost:8005
IPE_DEL_SVC_URL=http://localhost:8006
IPE_NLP_SVC_URL=http://localhost:8007
IPE_ML_SVC_URL=http://localhost:8016

# ─── Integrations ────────────────────────────────────────────────────────────
IPE_PAGERDUTY_ROUTING_KEY=
IPE_ALERTMANAGER_URL=

# ─── Feature Flags ───────────────────────────────────────────────────────────
IPE_LLM_ROUTING_ENABLED=false

# ─── Environment ─────────────────────────────────────────────────────────────
IPE_ENVIRONMENT=development
IPE_LOG_LEVEL=DEBUG
IPE_CORS_ORIGINS=http://localhost:3000
IPE_SERVICE_NAME=unknown
IPE_VERSION=0.1.0
